{
  "manifest_version": 2,
  "id": "github.cateye.mai.set_avatar",
  "version": "1.0.2",
  "name": "麦麦要换头像",
  "description": "让 bot 每天定时从头像库随机抽取一张更换 QQ 头像：支持触发时间随机漂移与跳过概率；首次运行自动捕获 bot 当前头像入库；/msa bot 捕获当前头像、/msa list [组号] 合并转发按序号浏览（单张压缩至 500KB 内，每组 20 张，增删后序号紧凑重排）、/msa remove 序号 移除、/msa add 收集头像；管理员 = 宿主操作员 ∪ 插件配置（自动去重）；更换头像后可向 planner / replyer 注入带时间戳的提醒（保留时长可配置）；LLM 工具换头像（每日上限 + 冷却，不可用时自动隐藏工具）。需要安装 SnowLuma 或 NapCat 适配器之一（无硬性插件依赖）。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_mai_set_avatar",
    "homepage": "https://github.com/cateyemizuki/cateye_mai_set_avatar",
    "documentation": "https://github.com/cateyemizuki/cateye_mai_set_avatar/blob/main/README.md",
    "issues": "https://github.com/cateyemizuki/cateye_mai_set_avatar/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=9.0.0"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    },
    {
      "type": "python_package",
      "name": "yarl",
      "version_spec": ">=1.0"
    }
  ],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "image",
      "fallback": "shuffle"
    }
  },
  "capabilities": [
    "send.text",
    "send.forward",
    "message.get_by_id",
    "api.call",
    "api.get",
    "config.get",
    "component.enable",
    "component.disable"
  ],
  "changelog": "CHANGELOG.md",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  }
}
